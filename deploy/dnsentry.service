# systemd unit for DNSentry.
#   install -m 0755 dnsentry /usr/local/bin/dnsentry
#   install -m 0644 deploy/dnsentry.service /etc/systemd/system/
#   systemctl enable --now dnsentry
# Configuration and data live in /var/lib/dnsentry (created on first start).
# Put DNSENTRY_* variables, e.g. DNSENTRY_API_TOKEN, in /etc/dnsentry/env.
[Unit]
Description=DNSentry DNS filtering server
Documentation=https://github.com/teliso/DNSentry
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/dnsentry -config /var/lib/dnsentry/config.yaml
WorkingDirectory=/var/lib/dnsentry
EnvironmentFile=-/etc/dnsentry/env
Environment=DNSENTRY_DNS_LISTEN=:53
Restart=on-failure
RestartSec=5s

DynamicUser=yes
StateDirectory=dnsentry
StateDirectoryMode=0700
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
